{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "owlaria-locale-redirect",
  "main": "cloudflare/locale-redirect-worker.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "owlaria.overpatch.dev/*",
      "zone_name": "overpatch.dev",
    },
  ],
}
