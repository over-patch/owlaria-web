---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { siteCopy } from '../content/site';
import { absoluteLocaleUrl, locales, type Locale } from '../i18n/config';
import { LOCALE_PREFERENCE_COOKIE } from '../i18n/locale-preference';
import '../styles/global.css';
import interFontStylesheet from '@fontsource-variable/inter/wght.css?url';
import japaneseFontStylesheet from '@fontsource-variable/noto-sans-jp/wght.css?url';

interface Props {
  locale: Locale;
  pathname: string;
  title: string;
  description: string;
}

const { locale, pathname, title, description } = Astro.props;
const englishUrl = absoluteLocaleUrl('en', pathname);
const japaneseUrl = absoluteLocaleUrl('ja', pathname);
const canonicalUrl = absoluteLocaleUrl(locale, pathname);
const fontStylesheet =
  locale === 'ja' ? japaneseFontStylesheet : interFontStylesheet;
const detectBrowserLocale = locale === 'en' && pathname === '/';
const browserLocaleRedirectScript = `
  const supportedLocales = ${JSON.stringify(locales)};
  const localePreferenceCookie = ${JSON.stringify(LOCALE_PREFERENCE_COOKIE)};
  const storedLocale = document.cookie
    .split(';')
    .map((cookie) => cookie.trim().split('=', 2))
    .find(
      ([name, value]) =>
        name === localePreferenceCookie && supportedLocales.includes(value),
    )?.[1];

  if (!storedLocale) {
    const languages =
      navigator.languages.length > 0
        ? navigator.languages
        : [navigator.language];
    const preferredLocale = languages
      .map((language) => language.toLowerCase().split('-')[0])
      .find((language) => supportedLocales.includes(language));

    if (preferredLocale === 'ja') {
      const attributes = [
        localePreferenceCookie + '=ja',
        'Max-Age=31536000',
        'Path=/',
        'SameSite=Lax',
      ];
      if (window.location.protocol === 'https:') {
        attributes.push('Secure');
      }
      document.cookie = attributes.join('; ');

      const redirectUrl = new URL(window.location.href);
      redirectUrl.pathname = '/ja/';
      window.location.replace(redirectUrl.href);
    }
  }
`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#030611" />
    <link rel="stylesheet" href={fontStylesheet} />
    <link rel="icon" type="image/png" href="/owlaria-app-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="ja" href={japaneseUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <meta property="og:site_name" content="Owlaria" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta
      property="og:image"
      content="https://owlaria.overpatch.dev/social/owlaria-social.png"
    />
    <meta name="twitter:card" content="summary_large_image" />
    {
      detectBrowserLocale && (
        <script is:inline set:html={browserLocaleRedirectScript} />
      )
    }
    <script is:inline>
      document.documentElement.classList.add('has-js');
    </script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content"
      >{siteCopy[locale].skipToContent}</a
    >
    <SiteHeader {locale} {pathname} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter {locale} {pathname} />
    <script>
      import '../scripts/locale-preference';
      import '../scripts/motion';
      import '../scripts/semantic-heading-fallback';
    </script>
  </body>
</html>
