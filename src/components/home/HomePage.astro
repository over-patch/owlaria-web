---
import { homeCopy, platformAction, platforms } from '../../content/home';
import { localePath, type Locale } from '../../i18n/config';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PlatformCard from './PlatformCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = homeCopy[locale];
---

<SiteLayout
  {locale}
  pathname="/"
  title={copy.metadata.title}
  description={copy.metadata.description}
>
  <section class="home-hero shell">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow">{copy.hero.eyebrow}</p>
      <h1>{copy.hero.heading}</h1>
      <p class="hero-body">{copy.hero.body}</p>
      <ul class="hero-proof-points" aria-label={copy.hero.eyebrow}>
        {copy.hero.proofPoints.map((point) => <li>{point}</li>)}
      </ul>
      <div class="hero-availability" aria-label={copy.platforms.body}>
        <span>macOS</span>
        <span>iOS</span>
        <strong>{copy.platforms.comingSoon}</strong>
      </div>
    </div>

    <div class="product-story" data-reveal>
      <div class="story-node story-source">
        <span class="story-symbol" aria-hidden="true">NAS</span>
        <strong>{copy.hero.sourceLabel}</strong>
      </div>
      <span class="story-connector" aria-hidden="true"></span>
      <div class="story-node story-guardian">
        <img
          class="story-icon"
          src="/owlaria-app-icon.png"
          width="96"
          height="96"
          alt=""
        />
        <strong>{copy.hero.protectionLabel}</strong>
      </div>
      <span class="story-connector" aria-hidden="true"></span>
      <div class="story-node story-devices">
        <span class="story-symbol" aria-hidden="true">macOS · iOS</span>
        <strong>{copy.hero.deviceLabel}</strong>
      </div>
    </div>
  </section>

  <section
    class="capability-section shell"
    aria-labelledby="capability-heading"
  >
    <div class="section-heading" data-reveal>
      <p class="eyebrow">{copy.capabilities.eyebrow}</p>
      <h2 id="capability-heading">{copy.capabilities.heading}</h2>
      <p>{copy.capabilities.body}</p>
    </div>
    <ul class="capability-grid">
      {
        copy.capabilities.items.map((item) => (
          <li data-reveal>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))
      }
    </ul>
    <a class="primary-link" href={localePath(locale, '/features/')}
      >{copy.capabilities.action}<span aria-hidden="true">→</span></a
    >
  </section>

  <section class="feature-section shell" aria-labelledby="feature-heading">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">{copy.features.eyebrow}</p>
      <h2 id="feature-heading">{copy.features.heading}</h2>
    </div>
    <ol class="feature-grid">
      {
        copy.features.items.map((feature) => (
          <li data-reveal>
            <span>{feature.number}</span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="platform-section shell" aria-labelledby="platform-heading">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">{copy.platforms.eyebrow}</p>
      <h2 id="platform-heading">{copy.platforms.heading}</h2>
      <p>{copy.platforms.body}</p>
    </div>
    <div class="platform-grid">
      {
        platforms.map((platform) => (
          <PlatformCard
            platform={platform}
            label={copy.platforms.labels[platform.id]}
            action={platformAction(
              platform,
              copy.platforms.labels[platform.id].detail,
              copy.platforms.comingSoon,
            )}
          />
        ))
      }
    </div>
    <p class="purchase-note">{copy.platforms.purchaseNote}</p>
  </section>

  <section class="closing-section shell" data-reveal>
    <img src="/owlaria-app-icon.png" width="96" height="96" alt="" />
    <p class="eyebrow">{copy.closing.eyebrow}</p>
    <h2>{copy.closing.heading}</h2>
    <p>{copy.closing.body}</p>
  </section>
</SiteLayout>
