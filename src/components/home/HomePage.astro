---
import { homeCopy, platformAction, platforms } from '../../content/home';
import { localePath, type Locale } from '../../i18n/config';
import SiteLayout from '../../layouts/SiteLayout.astro';
import HeadlineLines from '../HeadlineLines.astro';
import HomeCapabilityIcon from './HomeCapabilityIcon.astro';
import PlatformCard from './PlatformCard.astro';
import PlatformIcon from './PlatformIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = homeCopy[locale];
---

<SiteLayout
  {locale}
  pathname="/"
  title={copy.metadata.title}
  description={copy.metadata.description}
>
  <section class="home-hero shell">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow">{copy.hero.eyebrow}</p>
      <h1 aria-label={copy.hero.heading}>
        <span
          class="headline-lines"
          data-headline-variant="desktop"
          aria-hidden="true"
        >
          {copy.hero.desktopLines.map((line) => <span>{line}</span>)}
        </span>
        <span
          class="headline-lines"
          data-headline-variant="mobile"
          aria-hidden="true"
        >
          {copy.hero.mobileLines.map((line) => <span>{line}</span>)}
        </span>
      </h1>
      <figure
        class="hero-product-preview"
        aria-label={copy.hero.preview.label}
        data-testid="hero-product-preview"
      >
        <div class="hero-preview-stage">
          <div class="hero-preview-frame hero-preview-desktop">
            <img
              src="/screenshots/owlaria-library-macos.webp"
              width="1600"
              height="1037"
              alt={copy.hero.preview.desktopLabel}
            />
            <strong class="sr-only" data-testid="hero-preview-label">
              {copy.hero.preview.desktopLabel}
            </strong>
          </div>
          <div class="hero-preview-frame hero-preview-mobile">
            <img
              src="/screenshots/owlaria-library-ios.webp"
              width="603"
              height="1311"
              alt={copy.hero.preview.mobileLabel}
            />
            <strong class="sr-only" data-testid="hero-preview-label">
              {copy.hero.preview.mobileLabel}
            </strong>
          </div>
        </div>
      </figure>
      <ul class="hero-benefits" aria-label={copy.hero.eyebrow}>
        {
          copy.hero.benefits.map((benefit) => (
            <li>
              <h2>{benefit.title}</h2>
              <p>{benefit.body}</p>
            </li>
          ))
        }
      </ul>
      <p class="hero-platforms">
        <span class="hero-platform-item">
          <span class="hero-platform-icon" aria-hidden="true">
            <PlatformIcon platform="macos" />
          </span>
          <span>Mac</span>
        </span>
        <span aria-hidden="true">·</span>
        <span class="hero-platform-item">
          <span class="hero-platform-icon" aria-hidden="true">
            <PlatformIcon platform="ios" />
          </span>
          <span>iPhone</span>
        </span>
      </p>
      <div class="hero-actions">
        <a class="primary-link" href={localePath(locale, '/features/')}>
          {copy.hero.actions.features}<span aria-hidden="true">→</span>
        </a>
        <a
          class="secondary-link"
          href={localePath(locale, '/support/purchases/')}
        >
          {copy.hero.actions.purchases}<span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="feature-section shell" aria-labelledby="feature-heading">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">{copy.features.eyebrow}</p>
      <h2 id="feature-heading" aria-label={copy.features.heading}>
        <HeadlineLines
          desktopLines={copy.features.desktopLines}
          mobileLines={copy.features.mobileLines}
        />
      </h2>
    </div>
    <ol class="feature-grid">
      {
        copy.features.items.map((feature) => (
          <li data-reveal>
            <span class="feature-number">{feature.number}</span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </li>
        ))
      }
      <li class="reader-feature-card" data-reveal>
        <div class="reader-feature-header">
          <span class="feature-number">{copy.features.reader.number}</span>
          <div class="reader-feature-copy">
            <h3>{copy.features.reader.title}</h3>
            <p>{copy.features.reader.body}</p>
          </div>
        </div>
        <div class="reader-mode-grid">
          {
            copy.features.reader.modes.map((mode) => (
              <section class="reader-mode-group">
                <div class="reader-mode-heading">
                  <h4>{mode.title}</h4>
                </div>
                <ul>
                  {mode.options.map((option) => (
                    <li>{option}</li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      </li>
    </ol>
  </section>

  <section
    class="app-preview-section shell"
    aria-labelledby="app-preview-heading"
  >
    <div class="section-heading" data-reveal>
      <p class="eyebrow">{copy.screenshotShowcase.eyebrow}</p>
      <h2 id="app-preview-heading">{copy.screenshotShowcase.heading}</h2>
      <p>{copy.screenshotShowcase.body}</p>
    </div>
    <figure
      class="app-preview-frame"
      data-testid="app-screenshot-slot"
      data-reveal
    >
      <img
        class="app-preview-image"
        src="/screenshots/owlaria-viewer-macos-clean.webp"
        width="1600"
        height="1077"
        alt={copy.screenshotShowcase.placeholderLabel}
      />
    </figure>
  </section>

  <section
    class="compatibility-section shell"
    aria-labelledby="compatibility-heading"
  >
    <div class="section-heading compatibility-copy" data-reveal>
      <p class="eyebrow">{copy.compatibility.eyebrow}</p>
      <h2 id="compatibility-heading">{copy.compatibility.heading}</h2>
      <div class="compatibility-body">
        {copy.compatibility.body.map((sentence) => <p>{sentence}</p>)}
      </div>
    </div>
    <div class="compatibility-panel" data-reveal>
      <ul class="format-list" data-testid="format-list">
        {copy.compatibility.formats.map((format) => <li>{format}</li>)}
      </ul>
      <div class="password-support">
        <span class="password-symbol" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <rect x="5" y="10" width="14" height="10" rx="2"></rect>
            <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
            <path d="M12 14v2"></path>
          </svg>
        </span>
        <div>
          <strong>{copy.compatibility.passwordLabel}</strong>
          <span>{copy.compatibility.passwordFormats}</span>
        </div>
      </div>
    </div>
  </section>

  <section
    class="capability-section shell"
    aria-labelledby="capability-heading"
  >
    <div class="section-heading" data-reveal>
      <p class="eyebrow">{copy.capabilities.eyebrow}</p>
      <h2 id="capability-heading" aria-label={copy.capabilities.heading}>
        <HeadlineLines
          desktopLines={copy.capabilities.desktopLines}
          mobileLines={copy.capabilities.mobileLines}
        />
      </h2>
      <div class="capability-body">
        {copy.capabilities.body.map((sentence) => <p>{sentence}</p>)}
      </div>
    </div>
    <ul class="capability-grid">
      {
        copy.capabilities.items.map((item) => (
          <li data-reveal>
            <div class="capability-card-heading">
              <HomeCapabilityIcon name={item.icon} />
              <h3>{item.title}</h3>
            </div>
            <p>{item.body}</p>
          </li>
        ))
      }
    </ul>
    <a class="primary-link" href={localePath(locale, '/features/')}
      >{copy.capabilities.action}<span aria-hidden="true">→</span></a
    >
  </section>

  <section class="platform-section shell" aria-labelledby="platform-heading">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">{copy.platforms.eyebrow}</p>
      <h2 id="platform-heading" aria-label={copy.platforms.heading}>
        <HeadlineLines
          desktopLines={copy.platforms.desktopLines}
          mobileLines={copy.platforms.mobileLines}
        />
      </h2>
      <p>{copy.platforms.body}</p>
    </div>
    <div class="platform-grid">
      {
        platforms.map((platform) => (
          <PlatformCard
            platform={platform}
            label={copy.platforms.labels[platform.id]}
            action={platformAction(
              platform,
              copy.platforms.labels[platform.id].detail,
              copy.platforms.comingSoon,
            )}
          />
        ))
      }
    </div>
    <div class="platform-roadmap" data-reveal>
      <span>{copy.platforms.futureLabel}</span>
      <ul>
        {copy.platforms.futurePlatforms.map((platform) => <li>{platform}</li>)}
      </ul>
    </div>
    <p class="purchase-note">
      <strong>{copy.platforms.freeNote}</strong>
      <span>{copy.platforms.purchaseNote}</span>
    </p>
  </section>
</SiteLayout>
