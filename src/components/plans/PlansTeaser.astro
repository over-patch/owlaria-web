---
import { plansCopy } from '../../content/plans';
import { localePath, type Locale } from '../../i18n/config';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = plansCopy[locale];
---

<section class="plans-teaser shell" aria-labelledby="plans-teaser-title">
  <div class="teaser-copy">
    <p class="eyebrow">{copy.title}</p>
    <h2 id="plans-teaser-title">{copy.teaser.title}</h2>
    <p class="teaser-free">{copy.teaser.free}</p>
    <p>{copy.teaser.plus}</p>
  </div>
  <a class="primary-link" href={localePath(locale, '/plans/')}
    >{copy.compareAction}<span aria-hidden="true">→</span></a
  >
</section>
<style>
  .plans-teaser {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    margin-bottom: var(--section-gap);
    padding: var(--card-padding);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .teaser-copy {
    max-width: 44rem;
  }
  h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-section);
    line-height: 1.4;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  p:not(.eyebrow) {
    margin: var(--space-2) 0 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  p.teaser-free {
    color: var(--color-ink);
    font-weight: 650;
  }
  a {
    flex-shrink: 0;
    margin-top: 0;
  }
  @media (max-width: 60rem) {
    .plans-teaser {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }
  }
</style>
