---
import { featurePageCopy } from '../../content/features';
import { localePath, type Locale } from '../../i18n/config';
import SiteLayout from '../../layouts/SiteLayout.astro';
import HeadlineLines from '../HeadlineLines.astro';
import PhraseText from '../PhraseText.astro';
import SemanticPhraseText from '../SemanticPhraseText.astro';
import FeatureGlyph from './FeatureGlyph.astro';
import FeaturePlatformBadges from './FeaturePlatformBadges.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = featurePageCopy[locale];
const readerModeIcons = ['direction', 'pages', 'scroll'];
const temporaryViewerIcons = ['finder', 'drop', 'history'];
const featureCardIcons = {
  organize: ['search', 'filename', 'tracking', 'explorer'],
  library: ['series', 'folder', 'cover', 'lock', 'history'],
  statistics: ['chart', 'history', 'tag'],
  settings: ['sliders', 'keyboard'],
} as const;
---

<SiteLayout
  {locale}
  pathname="/features/"
  title={copy.metadata.title}
  description={copy.metadata.description}
>
  <header class="features-hero shell" data-reveal>
    <p class="eyebrow">{copy.hero.eyebrow}</p>
    <h1 aria-label={copy.hero.heading}>
      <HeadlineLines
        desktopLines={copy.hero.desktopLines}
        mobileLines={copy.hero.mobileLines}
      />
    </h1>
    <p class="feature-hero-body">{copy.hero.body}</p>
  </header>

  <nav
    class="feature-jump-nav shell"
    aria-label={copy.navigationLabel}
    data-reveal
  >
    <ol>
      {
        copy.sections.map((section) => (
          <li>
            <a href={`#${section.id}`}>
              <span>{section.number}</span>
              {section.label}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="feature-stories shell">
    {
      copy.sections.map((section) => (
        <section
          id={section.id}
          class:list={['feature-story', `feature-story-${section.visual}`]}
          aria-labelledby={`${section.id}-heading`}
          data-reveal
        >
          <div class="feature-story-layout">
            <header class="feature-story-heading">
              <p>
                <span>{section.number}</span>
                {section.label}
              </p>
              <h2 id={`${section.id}-heading`} aria-label={section.heading}>
                <HeadlineLines
                  desktopLines={section.desktopLines}
                  mobileLines={section.mobileLines}
                />
              </h2>
              <p class="feature-story-body">{section.body}</p>
              <FeaturePlatformBadges {locale} platforms={section.platforms} />
            </header>

            {section.visual === 'sources' && (
              <div
                class="feature-source-diagram"
                aria-label={copy.sourceDiagram.heading}
              >
                <header>
                  <h3>{copy.sourceDiagram.heading}</h3>
                  <p>{copy.sourceDiagram.body}</p>
                </header>
                <ul>
                  {copy.sourceDiagram.sources.map((source, index) => (
                    <li class="feature-source-node">
                      <FeatureGlyph
                        name={index < 2 ? 'server' : 'sourceFolder'}
                        className={`feature-source-icon ${
                          index < 2
                            ? 'feature-source-icon-server'
                            : 'feature-source-icon-folder'
                        }`}
                      />
                      <span>{source}</span>
                    </li>
                  ))}
                </ul>
                <div class="feature-source-connector">
                  <svg
                    viewBox="0 0 24 80"
                    preserveAspectRatio="xMidYMid meet"
                    aria-hidden="true"
                  >
                    <path d="M12 0v70M5 63l7 7 7-7" />
                  </svg>
                  <span>{copy.sourceDiagram.connector}</span>
                </div>
                <article class="feature-source-output">
                  <img
                    src="/owlaria-app-icon.png"
                    width="72"
                    height="72"
                    alt=""
                  />
                  <div>
                    <h3>{copy.sourceDiagram.outputHeading}</h3>
                    <p>{copy.sourceDiagram.outputBody}</p>
                  </div>
                </article>
              </div>
            )}

            {section.preview && (
              <figure
                class:list={[
                  'feature-product-preview',
                  `feature-product-preview-${section.visual}`,
                ]}
                data-testid="feature-product-preview"
              >
                <div class="feature-preview-stage">
                  <img
                    src={section.preview.image}
                    width={
                      section.visual === 'reader'
                        ? 1600
                        : section.preview.platform === 'MAC'
                          ? 1432
                          : 603
                    }
                    height={
                      section.visual === 'reader'
                        ? 1077
                        : section.preview.platform === 'MAC'
                          ? 928
                          : 1311
                    }
                    alt={section.preview.title}
                  />
                </div>
              </figure>
            )}
          </div>

          {section.modeGroups && (
            <div class="feature-reader-modes">
              {section.modeGroups.map((group, index) => (
                <section class="feature-reader-mode-group">
                  <div class="feature-reader-mode-heading">
                    <FeatureGlyph
                      name={readerModeIcons[index]}
                      className="feature-reader-mode-icon"
                    />
                    <h3>{group.title}</h3>
                  </div>
                  <ul>
                    {group.values.map((value) => (
                      <li>{value}</li>
                    ))}
                  </ul>
                </section>
              ))}
            </div>
          )}

          {section.temporaryViewer && (
            <section
              class="feature-temporary-viewer"
              aria-labelledby={`${section.id}-temporary-viewer-heading`}
            >
              <div class="feature-temporary-viewer-intro">
                <header>
                  <p>{section.temporaryViewer.eyebrow}</p>
                  <FeaturePlatformBadges
                    {locale}
                    platforms={section.temporaryViewer.platforms}
                  />
                  <h3
                    id={`${section.id}-temporary-viewer-heading`}
                    aria-label={section.temporaryViewer.heading}
                  >
                    {section.temporaryViewer.headingLines.map((line) => (
                      <span>{line}</span>
                    ))}
                  </h3>
                  <p>{section.temporaryViewer.body}</p>
                </header>

                <div
                  class="feature-temporary-viewer-diagram"
                  aria-hidden="true"
                >
                  <div class="feature-temporary-file-stack">
                    <span>CBZ</span>
                    <span>RAR</span>
                    <span>ZIP</span>
                    <strong>{section.temporaryViewer.fileLabel}</strong>
                  </div>
                  <div class="feature-temporary-arrow">
                    <span>→</span>
                  </div>
                  <div class="feature-temporary-window">
                    <div class="feature-temporary-window-toolbar">
                      <i />
                      <i />
                      <i />
                    </div>
                    <div class="feature-temporary-window-body">
                      <img
                        src="/owlaria-app-icon.png"
                        width="56"
                        height="56"
                        alt=""
                      />
                      <strong>{section.temporaryViewer.viewerLabel}</strong>
                      <span>{section.temporaryViewer.notAddedLabel}</span>
                    </div>
                  </div>
                </div>
              </div>

              <ul class="feature-temporary-viewer-methods">
                {section.temporaryViewer.methods.map((method, index) => (
                  <li>
                    <div class="feature-temporary-method-heading">
                      <FeatureGlyph
                        name={temporaryViewerIcons[index]}
                        className="feature-temporary-method-icon"
                      />
                      <h4>{method.title}</h4>
                    </div>
                    <p>{method.body}</p>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <ul class="feature-story-grid">
            {section.items.map((item, index) => (
              <li>
                <div class="feature-card-heading">
                  {section.id in featureCardIcons && (
                    <FeatureGlyph
                      name={
                        featureCardIcons[
                          section.id as keyof typeof featureCardIcons
                        ][index]
                      }
                      className="feature-card-icon"
                    />
                  )}
                  <h3>{item.title}</h3>
                </div>
                <p>{item.body}</p>
                {item.platforms && (
                  <FeaturePlatformBadges {locale} platforms={item.platforms} />
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <section
    class="feature-environment-section shell"
    aria-labelledby="environment-heading"
    data-reveal
  >
    <header class="section-heading">
      <p class="eyebrow">{copy.environment.eyebrow}</p>
      <h2 id="environment-heading">{copy.environment.heading}</h2>
      <p>{copy.environment.body}</p>
    </header>
    <div class="feature-environment-panel">
      <strong>{copy.environment.smbVersion}</strong>
    </div>
  </section>

  <section
    class="formats-section shell"
    aria-labelledby="formats-heading"
    data-reveal
  >
    <header class="section-heading">
      <p class="eyebrow">{copy.formats.eyebrow}</p>
      <h2 id="formats-heading">
        <SemanticPhraseText
          phrases={copy.formats.headingPhrases}
          separator={locale === 'en' ? ' ' : ''}
        />
      </h2>
      <p>{copy.formats.body}</p>
    </header>
    <div class="feature-format-panel">
      <section class="feature-format-row feature-archive-formats">
        <div class="feature-format-heading">
          <FeatureGlyph name="archive" className="feature-format-icon" />
          <h3>{copy.formats.archiveLabel}</h3>
        </div>
        <div class="feature-format-values">
          <ul class="feature-format-badges">
            {
              copy.formats.archive.map((format) => (
                <li class="feature-format-badge">{format}</li>
              ))
            }
          </ul>
          <p class="feature-format-support-note">{copy.formats.passwordBody}</p>
        </div>
      </section>
      <section class="feature-format-row feature-image-formats">
        <div class="feature-format-heading">
          <FeatureGlyph name="images" className="feature-format-icon" />
          <h3>
            <SemanticPhraseText
              phrases={copy.formats.imageLabelPhrases}
              separator={locale === 'en' ? ' ' : ''}
            />
          </h3>
        </div>
        <ul class="feature-format-badges">
          {
            copy.formats.image.map((format) => (
              <li class="feature-format-badge">{format}</li>
            ))
          }
        </ul>
      </section>
    </div>
  </section>

  <section
    class="feature-platform-section shell"
    aria-labelledby="platform-heading"
    data-reveal
  >
    <header class="section-heading">
      <p class="eyebrow">{copy.availability.eyebrow}</p>
      <h2 id="platform-heading">
        <PhraseText text={copy.availability.heading} />
      </h2>
      <p>{copy.availability.body}</p>
    </header>
    <div class="feature-platform-groups">
      <section>
        <h3>{copy.availability.currentLabel}</h3>
        <ul>
          {
            copy.availability.currentPlatforms.map((platform) => (
              <li>
                <strong>{platform}</strong>
                <span>{copy.availability.comingSoon}</span>
              </li>
            ))
          }
        </ul>
      </section>
      <section class="feature-platform-future">
        <h3>{copy.availability.futureLabel}</h3>
        <ul>
          {
            copy.availability.futurePlatforms.map((platform) => (
              <li>
                <strong>{platform}</strong>
                <span>{copy.availability.futureLabel}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
    <div class="feature-pricing-note">
      <strong>{copy.availability.freeNote}</strong>
      <span>{copy.availability.purchaseNote}</span>
    </div>
    <nav
      class="feature-platform-actions"
      aria-label={copy.availability.eyebrow}
    >
      <a
        class="feature-platform-action feature-platform-action-primary"
        href={localePath(locale, '/support/purchases/')}
      >
        {copy.availability.actions.purchases}<span aria-hidden="true">→</span>
      </a>
      <a
        class="feature-platform-action"
        href={localePath(locale, '/releases/')}
      >
        {copy.availability.actions.releases}<span aria-hidden="true">→</span>
      </a>
      <a class="feature-platform-action" href={localePath(locale, '/')}>
        {copy.availability.actions.overview}<span aria-hidden="true">→</span>
      </a>
    </nav>
  </section>
</SiteLayout>
