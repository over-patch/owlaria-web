---
import { getCollection } from 'astro:content';

import ReleaseIndex from '../../components/releases/ReleaseIndex.astro';
import { hasReleaseMarkdown } from '../../lib/release-source';
import { selectLocalizedReleases } from '../../lib/releases';

const releases = selectLocalizedReleases(
  hasReleaseMarkdown ? await getCollection('releases') : [],
  'en',
);
---

<ReleaseIndex locale="en" {releases} />
